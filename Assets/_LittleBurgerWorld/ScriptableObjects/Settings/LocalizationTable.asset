%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9bfa3acb3c185e9c8a695c28143b3753, type: 3}
  m_Name: LocalizationTable
  m_EditorClassIdentifier: LittleBurgerWorld.Runtime::LittleBurgerWorld.Core.LocalizationTable
  languages:
  - en
  - es
  languageNames:
  - English
  - "Espa\xF1ol"
  entries:
  - key: lets_play
    values:
    - LET'S PLAY!
    - "\xA1A JUGAR!"
  - key: free_play
    values:
    - FREE PLAY
    - JUEGO LIBRE
  - key: parent_gate_question
    values:
    - 'Grown-ups only! Tap the answer:'
    - "\xA1Solo adultos! Toca la respuesta:"
  - key: settings_title
    values:
    - Parent Settings
    - Ajustes para padres
  - key: music
    values:
    - Music
    - "M\xFAsica"
  - key: sounds
    values:
    - Sounds
    - Sonidos
  - key: voice
    values:
    - Voice
    - Voz
  - key: voice_prompts
    values:
    - Spoken hints
    - Pistas habladas
  - key: language
    values:
    - Language
    - Idioma
  - key: reset_progress
    values:
    - Hold to reset progress
    - "Mant\xE9n pulsado para reiniciar"
  - key: progress_reset_done
    values:
    - Progress has been reset.
    - Se ha reiniciado el progreso.
  - key: privacy
    values:
    - Privacy
    - Privacidad
  - key: privacy_text
    values:
    - 'Little Burger World works completely offline.

      It does not collect,
      store or share any personal information.

      There are no ads, no purchases,
      no accounts, no analytics and no third-party tracking.

      Progress (stars,
      stickers and settings) is saved only on this device and can be erased with
      "Reset progress".'
    - "Little Burger World funciona totalmente sin conexi\xF3n.\nNo recopila, guarda
      ni comparte informaci\xF3n personal.\nNo hay anuncios, compras, cuentas, anal\xEDticas
      ni rastreo de terceros.\nEl progreso (estrellas, pegatinas y ajustes) se guarda
      solo en este dispositivo y se puede borrar con \"Reiniciar progreso\"."
  - key: stickers
    values:
    - Stickers
    - Pegatinas
  - key: say.add_bun
    values:
    - Put the bottom bun on the board!
    - "\xA1Pon el pan de abajo en la tabla!"
  - key: say.patty_on_grill
    values:
    - Put the patty on the grill.
    - Pon la carne en la parrilla.
  - key: say.flip_patty
    values:
    - Tap the patty to flip it!
    - "\xA1Toca la carne para darle la vuelta!"
  - key: say.patty_cooking
    values:
    - Sizzle sizzle! The patty is cooking.
    - "\xA1Chisporrotea! La carne se est\xE1 cocinando."
  - key: say.patty_on_bun
    values:
    - Yummy! Put the patty on the bun.
    - "\xA1Qu\xE9 rico! Pon la carne sobre el pan."
  - key: say.add_cheese
    values:
    - Add some cheese!
    - "\xA1A\xF1ade queso!"
  - key: say.add_top_bun
    values:
    - Now the top bun!
    - "\xA1Ahora el pan de arriba!"
  - key: say.serve_benny
    values:
    - Give the burger to Benny!
    - "\xA1Dale la hamburguesa a Benny!"
  - key: say.tap_potato
    values:
    - Tap the potatoes!
    - "\xA1Toca las patatas!"
  - key: say.fries_cooking
    values:
    - The fries are cooking!
    - "\xA1Las patatas se est\xE1n friendo!"
  - key: say.fries_in_box
    values:
    - Put the fries in the box.
    - Pon las patatas en la caja.
  - key: say.pick_flavour
    values:
    - Tap the strawberry flavour!
    - "\xA1Toca el sabor de fresa!"
  - key: say.pick_cup
    values:
    - Get a cup.
    - Coge un vaso.
  - key: say.press_lever
    values:
    - Press the big button!
    - "\xA1Pulsa el bot\xF3n grande!"
  - key: say.add_cream
    values:
    - Add whipped cream!
    - "\xA1A\xF1ade nata montada!"
  - key: say.add_straw
    values:
    - And a straw!
    - "\xA1Y una pajita!"
  - key: say.burger_on_tray
    values:
    - Put the burger on the tray.
    - Pon la hamburguesa en la bandeja.
  - key: say.fries_on_tray
    values:
    - Put the fries on the tray.
    - Pon las patatas en la bandeja.
  - key: say.shake_on_tray
    values:
    - Put the milkshake on the tray.
    - Pon el batido en la bandeja.
  - key: say.meal_ready
    values:
    - What a yummy meal!
    - "\xA1Qu\xE9 comida tan rica!"
