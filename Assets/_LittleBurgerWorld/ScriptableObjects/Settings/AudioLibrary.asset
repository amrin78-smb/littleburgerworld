  voice:
  - key: add_bun
    clip: {fileID: 0}
    transcript: Let's start with the bottom bun!
  - key: patty_on_grill
    clip: {fileID: 0}
    transcript: Put the patty on the grill.
  - key: flip_patty
    clip: {fileID: 0}
    transcript: Tap the patty to flip it!
  - key: patty_on_bun
    clip: {fileID: 0}
    transcript: Yummy! Put the patty on the bun.
  - key: add_cheese
    clip: {fileID: 0}
    transcript: Add some cheese!
  - key: add_top_bun
    clip: {fileID: 0}
    transcript: Now the top bun!
  - key: serve_benny
    clip: {fileID: 0}
    transcript: Give the burger to Benny!
  - key: tap_potato
    clip: {fileID: 0}
    transcript: Tap a potato!
  - key: fries_in_box
    clip: {fileID: 0}
    transcript: Put the fries in the box.
  - key: pick_flavour
    clip: {fileID: 0}
    transcript: Pick a flavour!
  - key: pick_cup
    clip: {fileID: 0}
    transcript: Get a cup.
  - key: press_lever
    clip: {fileID: 0}
    transcript: Press the big button!
  - key: add_cream
    clip: {fileID: 0}
    transcript: Add whipped cream!
  - key: add_straw
    clip: {fileID: 0}
    transcript: And a straw!
  - key: burger_on_tray
    clip: {fileID: 0}
    transcript: Put the burger on the tray.
  - key: fries_on_tray
    clip: {fileID: 0}
    transcript: Put the fries on the tray.
  - key: shake_on_tray
    clip: {fileID: 0}
    transcript: Put the milkshake on the tray.
